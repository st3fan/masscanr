# Docker Compose only: the native service still reads its environment.
# Generate a value with `openssl rand -hex 24`. Never commit the real .env.
MASSCANR_POSTGRES_PASSWORD=

# Optional: empty permits CRUD/preflight but scan starts require a real token.
VULTR_API_TOKEN=

# API publication on the Docker host.
MASSCANR_BIND_ADDRESS=127.0.0.1
MASSCANR_PORT=8080
